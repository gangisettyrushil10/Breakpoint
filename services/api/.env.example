# Copy to .env and fill in. .env is gitignored — never commit a real key.
# Create a key at https://platform.openai.com/api-keys — set a billing limit too.
OPENAI_API_KEY=sk-...

# Cheapest current tier; the model never computes numbers, so it doesn't need
# to be a strong one. Measured: ~4,800 tokens for a first turn, rising with the
# transcript — the whole thing is resent on every loop iteration.
OPENAI_MODEL=gpt-5.6-luna

# GPT-5.6 is a reasoning family. "none" is right for this workload;
# note "minimal" is rejected by 5.6 models.
OPENAI_REASONING_EFFORT=none

# Token-stream the answer as the model writes it, instead of releasing it
# sentence-at-a-time once generation finishes.
#
# The cost is real and worth understanding before switching this on. A turn is
# only known to be terminal *after* its text has arrived (the API emits text
# before any function_call item), so streaming the answer safely means
# regenerating it under tool_choice="none" — one extra model call per turn.
# Measured: 4,836 tokens off, 7,603 on, for the same question. Off, the prose
# still streams; it just starts a beat later.
# STREAM_ANSWER_TURN=1

# Per-turn records — stop reason, tool calls, token cost — are logged at INFO.
# LOG_LEVEL=INFO

# Comma-separated deployed frontend origins allowed to call the API.
# Local dev origins on ports 3000 and 3001 are always allowed.
# CORS_ALLOW_ORIGINS=https://breakpoint.example.com

# Set to 1 only when something in front of the app sets X-Forwarded-For.
# TRUST_PROXY_HEADERS=1
